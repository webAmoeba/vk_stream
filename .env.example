RTMP_URL="rtmp://<vk-server>/live"
STREAM_KEY="<vk-key>"

VIDEO_DIR="/root/downloads/myVideos"
START_EP="S02E16"
# Важно: при прожиге субтитров оставляйте только форматы с нужными дорожками.
VIDEO_EXTS=".mkv"

LOGLEVEL="info"
LOOP=1
PLAYLIST_PATH="var/playlist.txt"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Stream settings (on-the-fly subtitles + title)
STREAM_SUB_BURN=1
STREAM_SUB_SI=1
STREAM_AUDIO_INDEX=1
STREAM_SUB_FONTS_DIR=""
STREAM_SUB_FORCE_STYLE=""

STREAM_VIDEO_CODEC="libx264"
STREAM_VIDEO_BITRATE="4500k"
STREAM_MAXRATE="6000k"
STREAM_BUFSIZE="9000k"
STREAM_PRESET="veryfast"
STREAM_GOP=48
STREAM_FPS=""

STREAM_AUDIO_CODEC="aac"
STREAM_AUDIO_BITRATE="160k"
STREAM_AUDIO_RATE="48000"
STREAM_AUDIO_CHANNELS=2

# Title overlay (drawtext)
STREAM_DRAW_TEXT=1
STREAM_TITLE_FILE="var/nowplaying.txt"
STREAM_TITLE_MODE="stem"
STREAM_TITLE_PREFIX=""
STREAM_TITLE_DELAY=0
STREAM_TITLE_FONT_FILE="/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
STREAM_TITLE_SIZE=36
STREAM_TITLE_COLOR="white"
STREAM_TITLE_BOX=1
STREAM_TITLE_BOX_COLOR="black@0.5"
STREAM_TITLE_BOX_BORDER=10
STREAM_TITLE_X="20"
STREAM_TITLE_Y="20"

# Conversion settings (burn subtitles once)
# Set CONVERT_SCALE="" to keep original size
CONVERT_AUDIO_INDEX=1
CONVERT_SUB_SI=1
CONVERT_SUB_BURN=1
CONVERT_PRESET="veryfast"
# Приоритет: если задан CONVERT_VBITRATE, используется он, иначе CRF.
CONVERT_VBITRATE="5000k"
CONVERT_MAXRATE="6000k"
CONVERT_BUFSIZE="12000k"
CONVERT_CRF=20
CONVERT_AUDIO_BITRATE="160k"
CONVERT_AUDIO_RATE="48000"
CONVERT_AUDIO_CHANNELS=2
CONVERT_SCALE=""
CONVERT_OUT_EXT=".mp4"
CONVERT_INPUT_EXTS=".mkv"
CONVERT_OVERWRITE=0
