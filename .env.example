VK_URL="rtmp://ovsu.okcdn.ru/input/"
VK_KEY="<vk-key>"

VIDEO_DIR="/root/downloads/myVideos"
START_EP="S01E01"

# OBS websocket
OBS_HOST="127.0.0.1"
OBS_PORT=4455
OBS_PASSWORD="CHANGE_ME"
OBS_SCENE="Scene"
OBS_VLC_SOURCE="VLC"
OBS_TEXT_SOURCE="NowPlaying"

# Optional
VIDEO_EXTS=".mkv,.mp4"
LOOP=1
AUDIO_INDEX=1
SUB_SI=1
STREAM_VIDEO_BITRATE="3000k"
STREAM_AUDIO_BITRATE="160k"
STREAM_PRESET="superfast"
STREAM_GOP=48
STREAM_AUDIO_RATE="48000"
STREAM_AUDIO_CHANNELS=2
FFPROBE_PATH="ffprobe"
